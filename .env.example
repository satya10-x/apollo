MONGODB_URI=mongodb://127.0.0.1:27017/apollo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
PORT=4000
HOST=127.0.0.1
CLIENT_URL=http://127.0.0.1:5173

# Apollo execution caps. Per-session requests may lower these values.
APOLLO_MAX_ROUNDS=5
APOLLO_TIMEOUT_MS=1200000
APOLLO_MAX_SEARCH_REQUESTS=72
APOLLO_MAX_TOKENS=600000
APOLLO_MAX_COST_USD=

# Optional fallback: used at most once after a failed Groq attempt.
GEMINI_FALLBACK_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash

# Optional model-specific prices, USD. Leave blank if unknown.
# Tavily price should be a conservative per-request price for the selected search depth.
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
TAVILY_USD_PER_REQUEST=

# Athena retrieval: Exa is optional; arXiv needs no key.
EXA_FALLBACK_ENABLED=true
EXA_USD_PER_REQUEST=
ATHENA_SEARCH_CONCURRENCY=2
ATHENA_MAX_RETRIES=1
ATHENA_SEARCH_TIMEOUT_MS=30000
ATHENA_ARXIV_ENABLED=true
ATHENA_ARXIV_INTERVAL_MS=3000
